{
  "name": "@token-stats/cli",
  "version": "0.1.2",
  "description": "Token Stats CLI — track AI coding assistant token usage and costs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "token-stats": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Annihilater/token-stats.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@token-stats/cli-darwin-arm64": "0.1.2",
    "@token-stats/cli-darwin-x64": "0.1.2",
    "@token-stats/cli-linux-arm64-gnu": "0.1.2",
    "@token-stats/cli-linux-arm64-musl": "0.1.2",
    "@token-stats/cli-linux-x64-gnu": "0.1.2",
    "@token-stats/cli-linux-x64-musl": "0.1.2",
    "@token-stats/cli-win32-arm64-msvc": "0.1.2",
    "@token-stats/cli-win32-x64-msvc": "0.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "token-stats",
    "token-usage",
    "claude-code",
    "cursor",
    "gemini",
    "codex",
    "cli"
  ]
}
